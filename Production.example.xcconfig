// Copy this file to a non-secret production configuration or set this value in
// Xcode's Release build settings after deploying Backend/.
TEMPO_API_BASE_URL = https://YOUR-WORKER.workers.dev
INFOPLIST_KEY_TEMPO_API_BASE_URL = $(TEMPO_API_BASE_URL)

// These must be Football Live documents that accurately disclose GOAL API,
// Google Gemini, the app backend, data retention, and contact information.
FOOTBALLLIVE_TERMS_URL = https://YOUR-DOMAIN.example/football-live/terms
FOOTBALLLIVE_PRIVACY_URL = https://YOUR-DOMAIN.example/football-live/privacy
INFOPLIST_KEY_FOOTBALLLIVE_TERMS_URL = $(FOOTBALLLIVE_TERMS_URL)
INFOPLIST_KEY_FOOTBALLLIVE_PRIVACY_URL = $(FOOTBALLLIVE_PRIVACY_URL)

// Keep rights-sensitive content disabled until written licenses are obtained.
FOOTBALLLIVE_ALLOW_PROVIDER_VISUALS = NO
FOOTBALLLIVE_ALLOW_PROVIDER_VIDEOS = NO
INFOPLIST_KEY_FOOTBALLLIVE_ALLOW_PROVIDER_VISUALS = $(FOOTBALLLIVE_ALLOW_PROVIDER_VISUALS)
INFOPLIST_KEY_FOOTBALLLIVE_ALLOW_PROVIDER_VIDEOS = $(FOOTBALLLIVE_ALLOW_PROVIDER_VIDEOS)
